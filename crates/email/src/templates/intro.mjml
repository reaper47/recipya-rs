<mjml><mj-head><mj-title>Welcome to Recipya</mj-title><mj-preview>Your account has been created.</mj-preview><mj-attributes><mj-text font-weight="400" font-size="16px" color="#000000" line-height="24px"/></mj-attributes><mj-style inline="inline">body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif, serif; } .body-section { -webkit-box-shadow: 1px 4px 11px 0 rgba(0, 0, 0, 0.15); -moz-box-shadow: 1px 4px 11px 0 rgba(0, 0, 0, 0.15); box-shadow: 1px 4px 11px 0 rgba(0, 0, 0, 0.15); } .text-link { color: #5e6ebf } .footer-link { color: #888888 }</mj-style></mj-head><mj-body background-color="#E7E7E7" width="600px"><mj-wrapper padding-top="0" padding-bottom="0" css-class="body-section"><mj-section background-color="#ffffff" padding-left="15px" padding-right="15px"><mj-column width="100%"><mj-text color="#637381" font-size="16px"> Hello [[.UserName]], </mj-text><mj-text color="#637381" font-size="16px"> Welcome to Recipya! Please verify your account to get started. </mj-text><mj-button background-color="#f45e43" width="100%" color="white" href="[[.URL]]/auth/verify-email?token=[[.Token]]"> Verify email </mj-button><mj-text color="#637381" font-size="16px"> If the button above does not work, navigate to this link: [[.URL]]/auth/verify-email?token=[[.Token]] </mj-text><mj-text color="#637381" font-size="16px"> Sincerely, <br/> Recipya </mj-text></mj-column></mj-section></mj-wrapper></mj-body></mjml>
