# Stage 1: Build
FROM --platform=$BUILDPLATFORM rust:1.87.0-slim AS build

ARG TARGETPLATFORM
ARG BUILDPLATFORM

# Install base dependencies and cross-compilation tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        ca-certificates \
        perl \
        perl-base && \
    rm -rf /var/lib/apt/lists/*

# Install cross-compilation toolchain and target-specific dependencies
RUN case "$TARGETPLATFORM" in \
      "linux/arm64") \
        apt-get update && \
        apt-get install -y --no-install-recommends \
          gcc-aarch64-linux-gnu \
          libc6-dev-arm64-cross \
          libssl-dev:arm64 \
          libpq-dev:arm64 \
          ffmpeg && \
        rm -rf /var/lib/apt/lists/* && \
        echo "aarch64-unknown-linux-gnu" > /tmp/target.txt && \
        echo "CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc" >> /tmp/env.txt && \
        echo "CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++" >> /tmp/env.txt && \
        echo "AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar" >> /tmp/env.txt && \
        echo "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc" >> /tmp/env.txt && \
        echo "PKG_CONFIG_ALLOW_CROSS=1" >> /tmp/env.txt && \
        echo "PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig" >> /tmp/env.txt \
        ;; \
      "linux/amd64"|*) \
        apt-get update && \
        apt-get install -y --no-install-recommends \
          libssl-dev \
          libpq-dev \
          ffmpeg && \
        rm -rf /var/lib/apt/lists/* && \
        echo "x86_64-unknown-linux-gnu" > /tmp/target.txt && \
        touch /tmp/env.txt \
        ;; \
    esac

WORKDIR /usr/src/recipya

# Set environment variables for cross-compilation
RUN if [ -s /tmp/env.txt ]; then \
      while IFS= read -r line; do \
        echo "export $line" >> /etc/environment; \
      done < /tmp/env.txt; \
    fi

# QEMU-specific environment variables
ENV CARGO_NET_RETRY=10
ENV CARGO_INCREMENTAL=0
ENV RUST_BACKTRACE=0
ENV RUST_LOG=error
ENV OPENSSL_NO_VENDOR=1
ENV RUST_MIN_STACK=67108864
ENV CARGO_BUILD_JOBS=1

# Add Rust target for cross-compilation
RUN export TARGET=$(cat /tmp/target.txt) && \
    if [ "$TARGET" != "x86_64-unknown-linux-gnu" ]; then \
        rustup target add $TARGET; \
    fi

# Copy source
COPY . .

# Build with proper cross-compilation setup
RUN export TARGET=$(cat /tmp/target.txt) && \
    if [ -s /tmp/env.txt ]; then \
      set -a && . /tmp/env.txt && set +a; \
    fi && \
    if [ "$TARGET" = "x86_64-unknown-linux-gnu" ]; then \
        cargo build --release --locked; \
    else \
        ulimit -s unlimited && \
        cargo build --release --locked --target $TARGET --jobs 1; \
    fi

# Copy the built binary to a standard location
RUN export TARGET=$(cat /tmp/target.txt) && \
    if [ "$TARGET" = "x86_64-unknown-linux-gnu" ]; then \
        cp target/release/recipya-rs /usr/local/bin/recipya; \
    else \
        cp target/$TARGET/release/recipya-rs /usr/local/bin/recipya; \
    fi

# Rest of your dependency copying logic...
RUN mkdir -p /runtime-deps/usr/bin /runtime-deps/usr/lib /runtime-deps/lib
RUN cp /usr/bin/ffmpeg /usr/bin/ffprobe /runtime-deps/usr/bin/ 2>/dev/null || true

# Stage 2: Runtime
FROM gcr.io/distroless/cc-debian12
LABEL org.opencontainers.image.source="https://github.com/reaper47/recipya-rs" \
      org.opencontainers.image.description="A clean, simple and powerful recipe manager your whole family will enjoy." \
      org.opencontainers.image.licenses="AGPL-3.0"

COPY --from=build /runtime-deps/usr /usr
COPY --from=build /runtime-deps/lib /lib
COPY --from=build /usr/local/bin/recipya /usr/local/bin/recipya

USER nonroot:nonroot
EXPOSE 8078
CMD ["/usr/local/bin/recipya", "server"]
