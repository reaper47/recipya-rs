# Stage 1: Build
FROM --platform=$BUILDPLATFORM rust:1.87.0-slim AS build

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        libpq-dev \
        ffmpeg \
        pax-utils \
        ca-certificates \
        perl \
        perl-base && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/recipya

# QEMU-specific environment variables
ENV CARGO_NET_RETRY=10
ENV CARGO_INCREMENTAL=0
ENV RUST_BACKTRACE=0
ENV RUST_LOG=error
ENV OPENSSL_NO_VENDOR=1
ENV RUST_MIN_STACK=67108864
ENV CARGO_BUILD_JOBS=1

# For cross-compilation
ARG TARGETPLATFORM
RUN case "$TARGETPLATFORM" in \
      "linux/arm64") echo "aarch64-unknown-linux-gnu" > /tmp/target.txt ;; \
      "linux/amd64") echo "x86_64-unknown-linux-gnu" > /tmp/target.txt ;; \
      *) echo "x86_64-unknown-linux-gnu" > /tmp/target.txt ;; \
    esac

RUN export TARGET=$(cat /tmp/target.txt) && \
    if [ "$TARGET" != "x86_64-unknown-linux-gnu" ]; then \
        rustup target add $TARGET; \
    fi

# Copy source
COPY . .

# Build with target-specific optimizations
RUN export TARGET=$(cat /tmp/target.txt) && \
    if [ "$TARGET" = "x86_64-unknown-linux-gnu" ]; then \
        cargo build --release --locked; \
    else \
        # Use conservative settings for cross-compilation
        ulimit -s unlimited && \
        timeout 3600 cargo build --release --locked --target $TARGET --jobs 1 || \
        (echo "Retrying with even more conservative settings..." && \
         RUST_MIN_STACK=134217728 cargo build --release --locked --target $TARGET --jobs 1); \
    fi

RUN mkdir -p /runtime-deps/usr/bin /runtime-deps/usr/lib /runtime-deps/lib
RUN cp /usr/bin/ffmpeg /usr/bin/ffprobe /runtime-deps/usr/bin/ && \
    lddtree -l /usr/bin/ffmpeg /usr/bin/ffprobe | \
    grep -v '^(' | \
    xargs -I '{}' cp -L --parents '{}' /runtime-deps/ 2>/dev/null || true

RUN find /usr/lib -name "libpq.so*" -o \
         -name "libssl.so*" -o -name "libcrypto.so*" -o -name "libgssapi_krb5.so*" -o \
         -name "libldap*.so*" -o -name "libkrb5*.so*" -o -name "libk5crypto.so*" -o \
         -name "libsasl2.so*" -o -name "libgnutls.so*" -o -name "libcom_err.so*" -o \
         -name "libkeyutils.so*" | \
    xargs -I '{}' cp -L '{}' /runtime-deps/usr/lib/ 2>/dev/null || true

RUN find /lib -name "libpq.so*" -o \
         -name "libssl.so*" -o -name "libcrypto.so*" -o -name "libgssapi_krb5.so*" -o \
         -name "libldap*.so*" -o -name "libkrb5*.so*" -o -name "libk5crypto.so*" -o \
         -name "libsasl2.so*" -o -name "libgnutls.so*" -o -name "libcom_err.so*" -o \
         -name "libkeyutils.so*" | \
    xargs -I '{}' cp -L '{}' /runtime-deps/usr/lib/ 2>/dev/null || true

# ---------------------------------------------------
# 2 - Deploy Stage
# ---------------------------------------------------
FROM gcr.io/distroless/cc-debian12
LABEL org.opencontainers.image.source="https://github.com/reaper47/recipya-rs" \
      org.opencontainers.image.description="A clean, simple and powerful recipe manager your whole family will enjoy." \
      org.opencontainers.image.licenses="AGPL-3.0"

COPY --from=build /runtime-deps/usr /usr
COPY --from=build /runtime-deps/lib /lib
COPY --from=build /usr/src/recipya/target/release/recipya-rs /usr/local/bin/recipya

USER nonroot:nonroot
EXPOSE 8078
CMD ["/usr/local/bin/recipya", "server"]
