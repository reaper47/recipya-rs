# Stage 1: Build
FROM rust:1.87.0-slim AS build

# Accept target architecture as build arg
ARG TARGETPLATFORM
ARG BUILDPLATFORM

# Map Docker platforms to Rust targets
RUN case "$TARGETPLATFORM" in \
        "linux/amd64") echo "x86_64-unknown-linux-gnu" > /target.txt ;; \
        "linux/arm64") echo "aarch64-unknown-linux-gnu" > /target.txt ;; \
        *) echo "Unsupported platform: $TARGETPLATFORM" && exit 1 ;; \
    esac

# Install cross and dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        libpq-dev \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Install cross
RUN cargo install cross --git https://github.com/cross-rs/cross

WORKDIR /usr/src/recipya

# Set environment variables
ENV OPENSSL_NO_VENDOR=1
ENV PKG_CONFIG_ALLOW_CROSS=1

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Create dummy source and build dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cross build --release --target $(cat /target.txt) && \
    rm -rf src target/$(cat /target.txt)/release/deps/recipya*

# Copy source code
COPY . .

# Build the actual application
RUN cross build --release --locked --target $(cat /target.txt)

# Copy the binary to a standard location
RUN cp target/$(cat /target.txt)/release/recipya-rs /usr/local/bin/recipya

# ---------------------------------------------------
# 2 - Runtime Dependencies Stage
# ---------------------------------------------------
FROM debian:12-slim AS runtime-deps

ARG TARGETPLATFORM

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        pax-utils \
        libpq5 \
        libssl3 \
        libgssapi-krb5-2 \
        libldap-2.5-0 \
        libkrb5-3 \
        libk5crypto3 \
        libsasl2-2 \
        libgnutls30 \
        libcom-err2 \
        libkeyutils1 && \
    rm -rf /var/lib/apt/lists/*

# Create runtime dependencies directory
RUN mkdir -p /runtime-deps/usr/bin /runtime-deps/usr/lib /runtime-deps/lib

# Copy ffmpeg binaries
RUN cp /usr/bin/ffmpeg /usr/bin/ffprobe /runtime-deps/usr/bin/

# Copy required libraries using lddtree
RUN lddtree -l /usr/bin/ffmpeg /usr/bin/ffprobe | \
    grep -v '^(' | \
    xargs -I '{}' cp -L --parents '{}' /runtime-deps/ 2>/dev/null || true

# Determine architecture-specific library path
RUN case "$TARGETPLATFORM" in \
        "linux/amd64") echo "x86_64-linux-gnu" > /arch.txt ;; \
        "linux/arm64") echo "aarch64-linux-gnu" > /arch.txt ;; \
        *) echo "Unsupported platform: $TARGETPLATFORM" && exit 1 ;; \
    esac

# Copy architecture-specific libraries
RUN ARCH=$(cat /arch.txt) && \
    find /usr/lib/${ARCH} /lib/${ARCH} -name "libpq.so*" -o \
         -name "libssl.so*" -o -name "libcrypto.so*" -o -name "libgssapi_krb5.so*" -o \
         -name "libldap*.so*" -o -name "libkrb5*.so*" -o -name "libk5crypto.so*" -o \
         -name "libsasl2.so*" -o -name "libgnutls.so*" -o -name "libcom_err.so*" -o \
         -name "libkeyutils.so*" 2>/dev/null | \
    xargs -I '{}' cp -L '{}' /runtime-deps/usr/lib/ 2>/dev/null || true

# ---------------------------------------------------
# 3 - Final Stage
# ---------------------------------------------------
FROM gcr.io/distroless/cc-debian12

LABEL org.opencontainers.image.source="https://github.com/reaper47/recipya-rs" \
      org.opencontainers.image.description="A clean, simple and powerful recipe manager your whole family will enjoy." \
      org.opencontainers.image.licenses="AGPL-3.0"

# Copy runtime dependencies
COPY --from=runtime-deps /runtime-deps/usr /usr
COPY --from=runtime-deps /runtime-deps/lib /lib

# Copy application binary
COPY --from=build /usr/local/bin/recipya /usr/local/bin/recipya

USER nonroot:nonroot
EXPOSE 8078

CMD ["/usr/local/bin/recipya", "server"]
