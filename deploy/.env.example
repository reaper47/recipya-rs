# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------

# Address of the PostgreSQL connection
#
# Format: postgres://username:password@host:port/database
# Required
DATABASE_URL=postgres://postgres:postgres@localhost/recipya

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------

# Base HTTP address of the web application
#
# Required
RECIPYA_BASE_URL=http://localhost:8078

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------

# Whether the application is running in production mode.
#
# When enabled:
#   - Secure cookies (HTTPS only)
#
# Values: true | false
# Default: false
RECIPYA_IS_PRODUCTION=false

# ----------------------------------------------------------------------------
# FEATURES
# ----------------------------------------------------------------------------

# Automatically logs in users without authentication.
#
# Values: true | false
# Default: false
RECIPYA_IS_AUTOLOGIN=false

# Allow new user registrations.
# When disabled, only existing users can log in.
#
# Values: true | false.
# Default: false
RECIPYA_IS_ALLOW_SIGNUPS=false

# Whether the app is in demo mode.
#
# Values: true | false.
# Default: false
RECIPYA_IS_DEMO=false

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------------------------

# SMTP sender email address.
# This will appear as the "From" address in sent emails
#
# Default: (empty)
SMTP_FROM_EMAIL=""

# SMTP server hostname.
#
# Default: smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# SMTP server port.
#
# Common ports: 587 (TLS), 465 (SSL), 25 (plain)
# Default: 587
SMTP_PORT=587

# SMTP authentication username.
#
# Default: (empty)
SMTP_USERNAME=""

# SMTP authentication password
#
# Gmail users: Create an app password at https://myaccount.google.com/apppasswords
# Format for app passwords: "xxxx xxxx xxxx xxxx" (with spaces)
#
# Default: (empty)
SMTP_PASSWORD="abcd abcd bcd abcd"

#########################################################

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------

# Rust log level configuration
#
# Format: level,crate1=level,crate2=level
# Levels: trace | debug | info | warn | error
#
# Default: debug,tokio_cron_scheduler=off,reqwest=warn,hyper=warn
RUST_LOG=debug,tokio_cron_scheduler=off,reqwest=warn,hyper=warn
