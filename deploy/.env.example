# Sets the log level. Required.
RUST_LOG="debug,tokio_cron_scheduler=off,reqwest=warn,hyper=warn"

# Address of the PostgreSQL connection. Required.
RECIPYA_DATABASE_URL=postgres://postgres:postgres@localhost/recipya

# Base HTTP address of the web application. Required.
RECIPYA_BASE_URL=http://localhost:8078

# Whether to login automatically into the application.
# Possible values: "true" or "false".
# Default: "false".
RECIPYA_IS_AUTOLOGIN=true

# Whether the app is a demo version.
# Possible values: "true" or "false".
# Default: "false".
RECIPYA_IS_DEMO=false

# Whether to allow user account registrations.
# Possible values: "true" or "false".
# Default: "false".
RECIPYA_IS_ALLOW_SIGNUPS=false

# Emails can be sent using SMTP or SendGrid.
# To use SMTP, set the following variables:
RECIPYA_EMAIL_ADMIN=""
# The SMTP server host. Default: smtp.gmail.com
RECIPYA_EMAIL_SMTP_HOST=smtp.gmail.com
# Your SMTP server username. Can be the same as RECIPYA_EMAIL_ADMIN.
RECIPYA_EMAIL_SMTP_USERNAME=""
# Your SMTP server password. Please create an app password if you use gmail (https://myaccount.google.com/apppasswords).
RECIPYA_EMAIL_SMTP_PASSWORD=abcd abcd bcd abcd
