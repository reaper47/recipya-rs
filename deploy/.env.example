# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------

# File that stores the database username.
#
# Required
#
# If using Docker or Podman, the path is /run/secrets/db_user.
# If developing the application locally, the path is wherever the file lives on your system, i.e. `./secrets/db_user.txt`.
DATABASE_USER_FILE=/run/secrets/db_user

# File that stores the database user's password.
#
# Required
#
# If using Docker or Podman, the path is /run/secrets/db_password.
# If developing the application locally, the path is wherever the file lives on your system, i.e. `./secrets/db_password.txt`.
DATABASE_PASSWORD_FILE=/run/secrets/db_password

# Host of the PostgreSQL connection.
#
# Optional
#
# If using Docker, the host is `recipya-db`.
# If developing the application locally, the host is most likely `localhost`.
#
# Default: localhost
DATABASE_HOST=recipya-db

# Port of the PostgreSQL connection.
#
# Optional
#
# Default: 5432
DATABASE_PORT=5432

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------

# Base HTTP address of the web application
#
# Required
RECIPYA_BASE_URL=http://localhost:8078

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------

# Sets the application environment.
#
# Modes:
# - dev  (local development)
# - test (used by the test suite, which sets this automatically)
# - prod (production deployment)
#
# When `prod` is set:
#   - Cookies are marked secure and only sent over HTTPS.
#     Reference: https://developer.mozilla.org/en-US/docs/Web/Security/Practical_implementation_guides/Cookies#secure
#
# Users only need `dev` or `prod`.
#
# Values: dev | test | prod
# Default: dev
RECIPYA_APP_ENV=dev

# ----------------------------------------------------------------------------
# FEATURES
# ----------------------------------------------------------------------------

# Automatically logs in every visitor without authentication.
#
# Warning:
# Anyone who can reach the application gets full access.
# Only enable this on a trusted private networkA use case for setting this to `true` is when you are deploying this only for yourself and your family.
#
# Values: true | false
# Default: false
RECIPYA_AUTOLOGIN=true

# Allow new user registrations.
# When disabled, only existing users can log in.
#
# Values: true | false.
# Default: false
RECIPYA_ALLOW_SIGNUPS=false

# Whether the app is in demo mode.
#
# Values: true | false.
# Default: false
RECIPYA_IS_DEMO=false

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------------------------

# SMTP sender email address.
# This will appear as the "From" address in sent emails
#
# Default: (empty)
SMTP_FROM_EMAIL=""

# SMTP server hostname.
#
# Default: smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# SMTP server port.
#
# Common ports: 587 (TLS), 465 (SSL), 25 (plain)
# Default: 587
SMTP_PORT=587

# SMTP authentication username.
#
# Default: (empty)
SMTP_USERNAME=""

# SMTP authentication password
#
# Gmail users: Create an app password at https://myaccount.google.com/apppasswords
# Format for app passwords: "xxxx xxxx xxxx xxxx" (with spaces)
#
# Default: (empty)
SMTP_PASSWORD="abcd abcd bcd abcd"

#########################################################

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------

# Rust log level configuration
#
# Format: level,crate1=level,crate2=level
# Levels: trace | debug | info | warn | error
#
# Default: debug,tokio_cron_scheduler=off,reqwest=warn,hyper=warn
RUST_LOG=debug,tokio_cron_scheduler=off,reqwest=warn,hyper=warn
